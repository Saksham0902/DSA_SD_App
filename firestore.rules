rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ["sakshammathur429@gmail.com"];
    }
    // each person's synced progress: only they can read or write it
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // light profile + stats per person (accounts and guests): the admin can read
    match /profiles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    // activity log: anyone signed in (incl. guests) can add their own, only the admin reads
    match /events/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.t == request.time;
      allow read, delete: if isAdmin();
    }
  }
}
